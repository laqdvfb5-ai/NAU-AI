# Local development uses embedded PostgreSQL. Set DATABASE_URL for a server.
DATABASE_URL=
REDIS_URL=
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
APP_URL=http://localhost:3000
DATA_DIR=.data
DATA_MODE=synthetic
ALLOW_DEMO_LOGIN=true
DEMO_PASSWORD=
ADMIN_PASSWORD=
SESSION_SECRET=
RETENTION_DAYS=30
SEED_COUNT=120
# evidence: no environment model (chat requires configured API pool); openai: paid API; local: compatible server
LLM_PROVIDER=evidence
OPENAI_API_KEY=
LLM_SIMPLE_MODEL=gpt-5.6-luna
LLM_COMPLEX_MODEL=gpt-5.6-terra
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3.5:9b
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LOCAL_EMBEDDING_URL=http://localhost:8080/v1
MONTHLY_BUDGET_USD=20
MAX_REQUEST_COST_USD=0.20
SIMPLE_INPUT_USD_PER_M=0.20
SIMPLE_OUTPUT_USD_PER_M=1.20
COMPLEX_INPUT_USD_PER_M=2
COMPLEX_OUTPUT_USD_PER_M=12
EMBEDDING_INPUT_USD_PER_M=0.02
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Explicit mapping of immutable issuer+subject to canonical school identity; see docs/integration.md
OIDC_MAPPING_FILE=
STUDENT_PROVIDER_MODULE=
# Docker deployment only. DOMAIN is the host name without https://.
# Keep SESSION_SECRET unchanged after first deploy: it protects sessions and encrypted pool keys.
# POSTGRES_PASSWORD is embedded in DATABASE_URL, so use a URL-safe value (hex is suitable).
DOMAIN=
POSTGRES_PASSWORD=
